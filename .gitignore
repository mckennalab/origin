# Simulation and analysis outputs. Everything here is regenerated by the
# pipelines; output/ alone runs to several gigabytes.
/output/
/physicell_projects/

# Large input data. data/ is kept, but only for the small files the committed
# example parameters and regression tests actually read; the single-cell
# reference matrices are far too large for git and are fetched separately.
/data/*
!/data/example_pegRNA_pool.csv

# Vendored PHYLIP build. The tarball and unpacked tree are a downloaded
# dependency, not source; the small .phy examples beside them are kept.
/phylip/phylip-3.697/
/phylip/*.tar.gz
# phylip/ is itself a git checkout. Adding it records a bare gitlink with no
# .gitmodules entry, which clones as an empty directory and errors; it is a
# downloaded dependency and is ignored whole.
/phylip/

# R package build artifacts
*.Rcheck/
*.tar.gz
.Rproj.user/
.Rhistory
.RData
.Ruserdata
*.Rproj

# Editor and OS cruft
.DS_Store
**/.DS_Store
.idea/
*.iml
.ipynb_checkpoints/
Untitled*.ipynb

# Raw recorder datasets. saxe/ is a 19GB GEO download (GSM8791703, HL60 FLARE
# amplicons); like data/ it is fetched separately rather than committed.
/saxe/

# Simulation runs under analysis/results. Each results directory holds small
# summary tables at its top level -- the ones the figures read -- and beneath
# them the pipeline output for every run, which is gigabytes. The summaries are
# kept; the run subdirectories are not.
/analysis/results/*/calibrated/
/analysis/results/*/sweep_*/
/analysis/results/*/empirical_rates/
/analysis/results/*/fitted_shape/
/analysis/results/*/shipped_shape*/
/analysis/results/*/simulation/
/analysis/results/*/reconstruction*/
/analysis/results/*/*/condition*/
